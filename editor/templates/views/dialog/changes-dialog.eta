<div class="inb4doc-window" onclick="event.stopPropagation()">
  <div class="inb4doc-window-header" data-changes-target="header"><%= it.title %></div>
  <div class="inb4doc-window-body"><%~ it.rows %></div>
  <div class="inb4doc-window-actions">
    <button class="inb4doc-btn inb4doc-btn-primary" data-action="click->changes#saveAll">Save all</button>
    <button class="inb4doc-btn inb4doc-btn-danger"
      data-controller="press-twice"
      data-action="click->press-twice#click press-twice:confirm->changes#discardAll"
      data-press-twice-idle-text-value="Discard all"
      data-press-twice-pending-text-value="Press again"
      data-press-twice-timeout-value="3000"
    >Discard all</button>
    <button class="inb4doc-btn" data-action="click->changes#close">Close</button>
  </div>
</div>
