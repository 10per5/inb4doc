<div class="inb4doc-prefs-box about-dialog" onclick="event.stopPropagation()">
  <header class="prefs-header">
    <h3 class="prefs-title">About inb4doc</h3>
    <button type="button" class="prefs-x" data-action="click->about#close" aria-label="Close about"><%~ it.icons.xmark %></button>
  </header>
  <div class="prefs-body">
    <div class="about-hero">
      <span class="about-logo"><%~ it.icons.bookStack %></span>
      <p class="about-tagline">A WYSIWYG markdown wiki for the <code>inb4doc</code> project.</p>
      <% if (it.version) { %><p class="about-version">Version <%= it.version %></p><% } %>
    </div>
    <div class="about-links">
      <% for (const link of it.links) { %>
      <a class="about-link" href="<%= link.href %>" target="_blank" rel="noopener noreferrer">
        <span class="about-link-icon"><%~ link.icon %></span>
        <span class="about-link-text">
          <span class="about-link-title"><%= link.title %></span>
          <span class="about-link-sub"><%= link.subtitle %></span>
        </span>
        <span class="about-link-arrow"><%~ it.icons.navArrowRight %></span>
      </a>
      <% } %>
    </div>
  </div>
  <div class="inb4doc-prefs-actions">
    <button class="inb4doc-prefs-close" data-action="click->about#close">Close</button>
  </div>
</div>
