<div class="sidebar-wrapper">
  <div class="sidebar-search-wrapper" data-sidebar-target="searchWrapper">
    <input class="sidebar-search" type="text" placeholder="Find file…" data-sidebar-target="search" data-action="input->sidebar#onSearchInput" />
    <button class="btn btn-icon search-clear" data-action="click->sidebar#onSearchClear"></button>
  </div>
  <div class="sidebar-toolbar">
    <button class="btn btn-toggle sidebar-filters-btn" data-sidebar-target="filtersBtn" data-action="click->sidebar#onOpenFilters" title="Navigation filters"><%~ it.filterAlt %><span class="sidebar-toggle-label">Filters</span><span class="sidebar-filter-summary" data-sidebar-target="filterSummary"></span></button>
    <button class="btn sidebar-delete-selected" data-sidebar-target="deleteSelectedBtn" data-action="click->sidebar#onDeleteSelected" title="Delete selected" hidden>Delete selected (0)</button>
    <button class="btn sidebar-cancel-selection" data-sidebar-target="cancelSelectionBtn" data-action="click->sidebar#onCancelSelection" title="Cancel selection" hidden>Cancel</button>
  </div>
  <div class="sidebar-inner" data-sidebar-target="inner" data-action="dragstart->sidebar#onDragStart dragenter->sidebar#onDragEnter dragleave->sidebar#onDragLeave dragover->sidebar#onDragOver dragend->sidebar#onDragEnd drop->sidebar#onDrop">
    <div class="sidebar-skeleton" id="sidebar-skeleton">
      <div class="skel-bar skel-sidebar-line"></div>
      <div class="skel-bar skel-sidebar-line skel-w80"></div>
      <div class="skel-bar skel-sidebar-line skel-w60"></div>
      <div class="skel-bar skel-sidebar-line skel-w90"></div>
      <div class="skel-bar skel-sidebar-line skel-w70"></div>
      <div class="skel-bar skel-sidebar-line skel-w85"></div>
    </div>
  </div>
  <div class="sidebar-footer">
    <button class="nav-new-page" data-sidebar-target="newPageBtn" data-action="click->sidebar#onNewPage">+ New</button>
    <div class="sidebar-pending-row" data-sidebar-target="pendingRow" hidden>
      <button type="button" class="sidebar-pending-count" data-sidebar-target="pendingCount" data-action="click->sidebar#onReviewChanges" title="Review pending changes"></button>
      <button type="button" class="btn btn-icon sidebar-review-btn" data-sidebar-target="reviewBtn" data-action="click->sidebar#onReviewChanges" title="Review pending changes" aria-label="Review pending changes"><%~ it.reviewIcon %></button>
      <button type="button" class="btn btn-icon sidebar-save-btn" data-action="click->sidebar#onFlushAll" title="Save pending changes" aria-label="Save pending changes"><%~ it.saveIcon %></button>
    </div>
  </div>
</div>
