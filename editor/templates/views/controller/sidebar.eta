<div class="sidebar-wrapper">
  <div class="sidebar-provider-bar">
    <span class="provider-label" data-sidebar-target="providerLabel"></span>
    <button class="btn provider-change-btn" data-action="click->sidebar#onChangeProvider">Switch</button>
  </div>
  <div class="sidebar-search-wrapper" data-sidebar-target="searchWrapper">
    <input class="sidebar-search" type="text" placeholder="Find file…" data-sidebar-target="search" data-action="input->sidebar#onSearchInput" />
    <button class="btn btn-icon search-clear" data-action="click->sidebar#onSearchClear"></button>
  </div>
  <div class="sidebar-toolbar">
    <button class="btn btn-toggle sidebar-toggle-btn" data-sidebar-target="hideEmptyToggle" data-action="click->sidebar#onToggleEmptyFolders" title="Hide empty folders"><%~ it.eyeClosed %><span class="sidebar-toggle-label">Toggle empty</span></button>
  </div>
  <div class="sidebar-inner" data-sidebar-target="inner" data-action="dragstart->sidebar#onDragStart dragenter->sidebar#onDragEnter dragleave->sidebar#onDragLeave dragover->sidebar#onDragOver dragend->sidebar#onDragEnd drop->sidebar#onDrop">
    <div class="sidebar-skeleton" id="sidebar-skeleton">
      <div class="skel-bar skel-sidebar-line"></div>
      <div class="skel-bar skel-sidebar-line skel-w80"></div>
      <div class="skel-bar skel-sidebar-line skel-w60"></div>
      <div class="skel-bar skel-sidebar-line skel-w90"></div>
      <div class="skel-bar skel-sidebar-line skel-w70"></div>
      <div class="skel-bar skel-sidebar-line skel-w85"></div>
    </div>
  </div>
  <div class="sidebar-footer">
    <button class="nav-new-page" data-sidebar-target="newPageBtn" data-action="click->sidebar#onNewPage">+ New</button>
  </div>
</div>
