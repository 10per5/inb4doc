<% const active = it.panes.find(p => p.section === it.section) %>
<% if (active) { %>
<%~ it.renderScreen({
  title: active.label,
  closeAction: "click->prefs#backToMenu",
  closeLabel: "Back to preferences",
  closeIcon: "back",
  icons: it.icons,
  // The pushed screen already names the section in its title bar, so the pane
  // head (title + description) would only repeat it.
  body: `${active.html}`
}) %>
<% } else { %>
<% const rows = it.panes.map((pane) => `
    <button type="button" class="more-item" data-action="click->prefs#openSection" data-section="${it.PREFS_SECTION_PREFIX}${pane.section}">
      <span class="more-icon">${pane.icon}</span>
      <span class="more-label">${pane.label}</span>
      <span class="more-chevron">${it.icons.navArrowRight}</span>
    </button>`).join("") %>
<%~ it.renderScreen({
  title: "Preferences",
  closeAction: "click->prefs#close",
  closeLabel: "Back to more",
  closeIcon: "back",
  icons: it.icons,
  body: `
  <div class="more-list">
    ${rows}
  </div>`
}) %>
<% } %>
