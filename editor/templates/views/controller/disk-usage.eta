<%~ it.renderScreen({
  title: "Disk Stats",
  closeAction: "click->disk-usage#close",
  closeLabel: it.backLabel ?? "Close disk stats",
  closeIcon: it.backIcon ?? "xmark",
  icons: it.icons,
  body: `
  <div class="disk-usage-content">
    <div class="disk-usage-mode-toggle">
      <button class="disk-usage-mode-btn active" data-mode="dir" data-action="click->disk-usage#toggleMode">By Directory</button>
      <button class="disk-usage-mode-btn" data-mode="size" data-action="click->disk-usage#toggleMode">By Size</button>
    </div>
    <div class="disk-usage-chart-area" data-disk-usage-target="chartArea"></div>
    <div class="disk-usage-stats" data-disk-usage-target="statsArea"></div>
  </div>`
}) %>
