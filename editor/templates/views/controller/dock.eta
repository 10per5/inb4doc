<nav class="dock" role="tablist" aria-label="Primary">
  <button type="button" class="dock-item" role="tab" data-dock-target="item" data-dock-item="navigation" data-action="dock#activate">
    <span class="dock-icon"><%~ it.icons.bookStack %></span>
    <span class="dock-label">Files</span>
  </button>
  <button type="button" class="dock-item dock-item--editor" role="tab" data-dock-target="item" data-dock-item="editor" data-action="dock#activate" aria-label="Editor" title="Editor">
    <span class="dock-icon dock-icon--pencil"><%~ it.icons.editPencil %></span>
    <span class="dock-label">Editor</span>
  </button>
  <button type="button" class="dock-item" role="tab" data-dock-target="item" data-dock-item="more" data-action="dock#activate">
    <span class="dock-icon">
      <%~ it.icons.menuScale %>
      <span class="dock-badge" data-dock-target="badge" hidden>0</span>
    </span>
    <span class="dock-label">More</span>
  </button>
</nav>
