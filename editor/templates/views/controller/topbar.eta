  <div class="toolbar-section toolbar-section-left">
  <% if (it.mobileDock) { %>
    <span class="toolbar-heading-wrap">
      <button class="btn btn-icon toolbar-heading-btn" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ToggleHeadingDropdown] %>" title="Heading">
        <span class="heading-label">H</span>
      </button>
      <div class="toolbar-heading-dropdown">
        <button data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecHeading] %>" data-level="1" data-h="1">H1</button>
        <button data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecHeading] %>" data-level="2" data-h="2">H2</button>
        <button data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecHeading] %>" data-level="3" data-h="3">H3</button>
      </div>
    </span>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Bold %>" title="Bold"><%~ it.icons.bold %></button>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Italic %>" title="Italic"><%~ it.icons.italic %></button>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Strike %>" title="Strikethrough"><%~ it.icons.strikethrough %></button>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Link %>" title="Insert Link"><%~ it.icons.link %></button>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.SourceMode] %>" title="Source Mode"><%~ it.icons.codeBrackets %></button>
    <span class="toolbar-list-wrap">
      <button class="btn btn-icon toolbar-list-btn" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ToggleListDropdown] %>" title="List" aria-haspopup="true">
        <span class="list-label"><%~ it.icons.list %></span>
      </button>
      <div class="toolbar-list-dropdown">
        <button data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecList] %>" data-kind="bullet">Bullet list</button>
        <button data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecList] %>" data-kind="ordered">Ordered list</button>
        <button class="toolbar-list-task" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecList] %>" data-kind="task">Task list</button>
        <button class="toolbar-list-clear" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.ExitList %>" hidden>Clear List Item</button>
        <button class="toolbar-dropdown-hr" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Hr %>">Horizontal rule</button>
      </div>
    </span>
  <% } else { %>
    <% if (it.mobileCss && !it.mobileDock) { %>
      <button class="btn btn-icon btn-toggle-sidebar toolbar-mobile-only" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ToggleSidebar] %>" title="Toggle Sidebar"><%~ it.icons.menuScale %></button>
      <span class="toolbar-sep toolbar-mobile-only"></span>
    <% } %>
    <div class="toolbar-relative" data-menu-name="file" data-menu-mnemonic="f"></div>
    <% if (!it.mobileDock) { %>
    <div class="toolbar-relative" data-menu-name="view" data-menu-mnemonic="v"></div>
    <button class="btn btn-icon toolbar-history-btn" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Undo %>" title="Undo" disabled><%~ it.icons.undo %></button>
    <button class="btn btn-icon toolbar-history-btn" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Redo %>" title="Redo" disabled><%~ it.icons.redo %></button>
    <% } %>
  <% } %>
  </div>
  <% if (!it.mobileDock) { %>
  <span class="toolbar-sep"></span>
  <div class="toolbar-section toolbar-section-center">
    <span class="toolbar-heading-wrap">
      <button class="btn btn-icon toolbar-heading-btn" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ToggleHeadingDropdown] %>" title="Heading">
        <span class="heading-label">H</span>
      </button>
      <div class="toolbar-heading-dropdown">
        <button data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecHeading] %>" data-level="1" data-h="1">H1</button>
        <button data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecHeading] %>" data-level="2" data-h="2">H2</button>
        <button data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecHeading] %>" data-level="3" data-h="3">H3</button>
      </div>
    </span>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Bold %>" title="Bold (Ctrl+B)"><%~ it.icons.bold %></button>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Italic %>" title="Italic (Ctrl+I)"><%~ it.icons.italic %></button>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Strike %>" title="Strikethrough"><%~ it.icons.strikethrough %></button>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Code %>" title="Inline Code"><%~ it.icons.code %></button>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Hr %>" title="Insert Horizontal Rule"><%~ it.icons.minus %></button>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Blockquote %>" title="Quote"><%~ it.icons.quote %></button>
    <span class="toolbar-sep"></span>
    <span class="toolbar-list-wrap">
      <button class="btn btn-icon toolbar-list-btn" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ToggleListDropdown] %>" title="List" aria-haspopup="true">
        <span class="list-label"><%~ it.icons.list %></span>
      </button>
      <div class="toolbar-list-dropdown">
        <button data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecList] %>" data-kind="bullet">Bullet list</button>
        <button data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecList] %>" data-kind="ordered">Ordered list</button>
        <button class="toolbar-list-task" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ExecList] %>" data-kind="task">Task list</button>
        <button class="toolbar-list-clear" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.ExitList %>" hidden>Clear List Item</button>
      </div>
    </span>
    <span class="toolbar-sep"></span>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.Exec] %>" data-cmd="<%= it.TOOLBAR_CMD_PREFIX %><%= it.ToolbarCommand.Link %>" title="Insert Link"><%~ it.icons.link %></button>
    <span class="toolbar-sep"></span>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.SourceMode] %>" title="Source Mode"><%~ it.icons.codeBrackets %></button>
    <span class="toolbar-overflow-wrap" data-topbar-target="overflowWrap">
      <button class="btn btn-icon toolbar-overflow-btn" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.ToggleOverflowDropdown] %>" title="More formatting" data-topbar-target="overflowBtn" hidden><%~ it.icons.moreHoriz %></button>
      <div class="toolbar-overflow-dropdown" data-topbar-target="overflowDropdown"></div>
    </span>
  </div>
  <% } %>
  <div class="toolbar-spacer"></div>
  <div class="toolbar-section toolbar-section-right">
    <div class="dirty-counter" role="button" tabindex="0" data-topbar-target="dirtyCounter" data-action="click->topbar#dirtyClicked"></div>
    <button class="btn btn-accent flush-btn" data-topbar-target="flushBtn" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.FlushAll] %>" disabled><%~ it.icons.sort %></button>
    <% if (!it.mobileDock) { %>
    <button class="btn btn-icon" data-action="click->topbar#<%= it.toolbarActions[it.ToolbarAction.OpenPrefs] %>" title="Preferences"><%~ it.icons.settings %></button>
    <% } %>
  </div>
