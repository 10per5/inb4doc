<div class="prefs-pane">
  <div class="prefs-section">
    <div class="prefs-section-title">File tree</div>
    <label class="prefs-row">
      <input type="checkbox" id="inb4doc-hide-empty-checkbox" <%= it.prefs.hideEmptyFolders ? "checked" : "" %> data-action="change-><%= it.controller %>#hideEmptyChanged">
      <span class="prefs-row-text">
        <span class="prefs-row-label">Hide empty folders</span>
        <span class="prefs-row-hint">Folders with no readable page in them are skipped.</span>
      </span>
    </label>
  </div>
  <div class="prefs-section">
    <div class="prefs-section-title">Project</div>
    <p class="prefs-note">Limit the tree to one root-level project, or show every project side by side.</p>
    <div class="project-badges">
      <button type="button" class="project-badge<%= it.prefs.rootScope ? "" : " is-active" %>" data-prefs-target="projectBadge" data-project-value="" aria-pressed="<%= it.prefs.rootScope ? "false" : "true" %>" data-action="click-><%= it.controller %>#projectPicked">
        <span class="project-badge-label">Show all</span>
      </button>
      <% for (const folder of it.badgeFolders) { %>
      <button type="button" class="project-badge<%= it.prefs.rootScope === folder.path ? " is-active" : "" %>" data-prefs-target="projectBadge" data-project-value="<%= folder.path %>" aria-pressed="<%= it.prefs.rootScope === folder.path ? "true" : "false" %>" data-action="click-><%= it.controller %>#projectPicked">
        <span class="project-badge-label"><%= folder.label %></span>
        <% if (folder.count) { %><span class="project-badge-count" title="<%= folder.count %> page<%= folder.count === 1 ? "" : "s" %>"><%= folder.count %></span><% } %>
      </button>
      <% } %>
      <button type="button" class="project-badge project-badge-more" data-prefs-target="projectMore" aria-expanded="false" data-action="click-><%= it.controller %>#toggleProjectTable">
        <span class="project-badge-label">More…</span>
      </button>
    </div>
    <div class="project-table-wrap" data-prefs-target="projectTable" data-page="0" data-page-count="<%= it.projectPages %>" hidden>
      <table class="project-table">
        <thead>
          <tr>
            <th scope="col">Project</th>
            <th scope="col" class="project-col-pages">Pages</th>
          </tr>
        </thead>
        <tbody>
          <% for (const row of it.projectRows) { %>
          <tr class="project-row<%= it.prefs.rootScope === row.value ? " is-active" : "" %>" data-prefs-target="projectRow" data-project-value="<%= row.value %>" data-page="<%= row.page %>"<%= row.page === 0 ? "" : " hidden" %> tabindex="0" role="button" data-action="click-><%= it.controller %>#projectPicked keydown-><%= it.controller %>#projectRowKey">
            <td class="project-col-name">
              <span class="project-row-label"><%= row.label %></span>
            </td>
            <td class="project-col-pages"><%= row.count || "—" %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
      <% if (it.projectPages > 1) { %>
      <div class="project-pager">
        <button type="button" class="project-pager-btn" data-prefs-target="projectPrevPage" aria-label="Previous page" disabled data-action="click-><%= it.controller %>#projectPrevPage"><%~ it.icons.navArrowLeft %></button>
        <span class="project-pager-label" data-prefs-target="projectPageLabel">1 / <%= it.projectPages %></span>
        <button type="button" class="project-pager-btn" data-prefs-target="projectNextPage" aria-label="Next page" data-action="click-><%= it.controller %>#projectNextPage"><%~ it.icons.navArrowRight %></button>
      </div>
      <% } %>
    </div>
    <% if (it.rootFolderCount === 0) { %>
    <p class="prefs-note">This content root has no root-level folders.</p>
    <% } %>
    <% if (it.canOpenProject) { %>
    <button type="button" class="btn prefs-inline-btn" data-action="click-><%= it.controller %>#openProject">
      <span class="btn-icon"><%~ it.icons.folderOpen %></span>
      <span>Open another folder…</span>
    </button>
    <% } %>
  </div>
</div>
