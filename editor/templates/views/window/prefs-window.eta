<nav class="prefs-tabs" role="tablist" aria-label="Preference sections">
  <% for (const pane of it.panes) { %>
  <button type="button" role="tab" class="prefs-tab<%= pane.active ? " is-active" : "" %>" data-prefs-target="tab" data-section="<%= it.PREFS_SECTION_PREFIX %><%= pane.section %>" aria-selected="<%= pane.active ? "true" : "false" %>" data-action="click->prefs#switchTab">
    <span class="prefs-tab-icon"><%~ pane.icon %></span>
    <span class="prefs-tab-label"><%= pane.label %></span>
  </button>
  <% } %>
</nav>
<div class="prefs-panes">
  <% for (const pane of it.panes) { %>
  <section class="prefs-pane-wrap" role="tabpanel" data-prefs-target="pane" data-section="<%= it.PREFS_SECTION_PREFIX %><%= pane.section %>" <%= pane.active ? "" : "hidden" %>>
    <div class="prefs-pane-head">
      <h4 class="prefs-pane-title"><%= pane.label %></h4>
      <p class="prefs-pane-desc"><%= pane.description %></p>
    </div>
    <%~ pane.html %>
  </section>
  <% } %>
</div>
