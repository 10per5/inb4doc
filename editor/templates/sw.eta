// build: <%= it.buildVersion %>
self.BUILD_VERSION = <%~ JSON.stringify(it.buildVersion) %>;
self.CHUNK_MAP = <%~ JSON.stringify(it.chunkMap) %>;
importScripts(<%~ JSON.stringify(it.swAssetsUrl) %>);

const CACHE = "inb4doc-assets-v1";
// Cache entry listing the chunk URLs precached by the last completed install.
// Content-hashed chunk URLs are immutable, so the next install can skip any
// chunk already on this list (see the install handler).
const PRECACHED_KEY = "/__inb4doc_precached__";
const NETWORK_FIRST = <%= it.isDev %>;
const CACHE_MAPS = <%= it.cacheMaps %>;

console.info("[SW] v<%= it.appVersion %> build:<%= it.buildVersion %> networkFirst:", NETWORK_FIRST);

// Transport-agnostic updater core (byte-counted transfer + manifest diff +
// version guard), shared verbatim with the page-side updaters (Part C).
<%~ include('partials/updater-core', it) %>

function reportProgress(loaded, total, done) {
  self.clients.matchAll({ includeUncontrolled: true }).then((clients) => {
    for (const c of clients) {
      c.postMessage({ type: "SW_INSTALL_PROGRESS", loaded, total, done });
    }
  });
}

// Cache Storage backend for updaterTransfer (the byte-counted GET + skip-Cached
// loop lives in the shared updater-core). sizeOf() is the fallback for servers
// that don't send content-length on GET: it lets the transfer denominator reuse
// sizes we already know from an earlier install.
const cacheStorage = {
  async sizeOf(url) {
    try {
      const cached = await caches.match(url);
      return Number(cached?.headers.get("content-length")) || 0;
    } catch (_) {
      return 0;
    }
  },
  async put(url, response) {
    const cache = await caches.open(CACHE);
    await cache.put(url, response);
  },
  async has(url) {
    try {
      return Boolean(await caches.match(url));
    } catch (_) {
      return false;
    }
  },
};

self.addEventListener("install", (event) => {
  // Take control immediately on every mode. Without this the new SW sits in
  // "waiting" forever in production, SW_ACTIVATED never fires, and the old SW
  // keeps serving stale app.js/chunks from its cache on every reload.
  self.skipWaiting()
  event.waitUntil(
    (async () => {
      // Chunk URLs precached by the last completed install. Content-hashed
      // chunk URLs are immutable, so a chunk already on this list is
      // byte-identical to the cached copy and can be skipped — only
      // new/changed chunks (whose URL isn't listed) are fetched and counted.
      // Reading the persisted list instead of the live cache avoids the race
      // where the page re-caches a chunk through the fetch path while the
      // install is still running: that chunk is absent from the list, so it
      // still gets fetched and counted.
      const cache = await caches.open(CACHE);
      let precached = new Set();
      try {
        const meta = await cache.match(PRECACHED_KEY);
        if (meta) precached = new Set(JSON.parse(await meta.text()));
      } catch (_) {
        // Corrupt/missing list — treat every chunk as not precached.
      }
      const progress = (loaded, total, done) => reportProgress(loaded, total, done);
      // `skipCached` is for content-hashed chunks: once a chunk URL is on the
      // precached list it is byte-identical forever, so re-installs skip it
      // entirely — only genuinely new/changed chunks are fetched and counted.
      // IMPORTANT assets are build-versioned with stable URLs and change on
      // every build, so they always transfer.
      //
      // Block activation only on the IMPORTANT assets (shell + entry + app.js);
      // first paint never waits on the lazy controller chunks.
      await updaterTransfer(self.IMPORTANT, {
        storage: cacheStorage,
        precached,
        skipCached: false,
        onProgress: progress,
      });
      // Fill the remaining chunks in the background without delaying activation.
      // Already-precached chunks are skipped, so only changed files are fetched.
      self.backgroundFill = (async () => {
        await updaterTransfer(self.CHUNKS, {
          storage: cacheStorage,
          precached,
          skipCached: true,
          onProgress: progress,
        });
        // Persist the chunk set now in the cache so the next install skips
        // them. Only URLs actually present are recorded, so a failed transfer
        // is retried on the next install instead of skipped.
        try {
          const list = [];
          for (const url of self.CHUNKS) {
            if (await cacheStorage.has(url)) list.push(url);
          }
          await cache.put(
            PRECACHED_KEY,
            new Response(JSON.stringify(list), {
              headers: { "Content-Type": "application/json" },
            })
          );
        } catch (_) {}
      })();
    })()
  );
});

self.addEventListener("activate", (event) => {
  event.waitUntil(
    (async () => {
      await self.clients.claim();
      for (const client of await self.clients.matchAll()) {
        client.postMessage({
          type: "SW_ACTIVATED",
          version: self.BUILD_VERSION,
          buildVersion: self.BUILD_VERSION,
          chunkMap: self.CHUNK_MAP,
          chunks: self.CHUNKS,
          appHash: self.APP_HASH,
          indexHash: self.INDEX_HASH,
          affectedBy: self.AFFECTED_BY,
          coldOnChange: self.COLD_ON_CHANGE,
        });
      }
      for (const key of await caches.keys()) {
        if (key !== CACHE) await caches.delete(key);
      }
    })()
  );
});

// Entry shell + app.js are versioned only by build, not by content hash, so a
// cache-first policy would serve the stale bundle forever. Always go to the
// network for IMPORTANT paths (falling back to cache offline). katex.css is
// likewise build-versioned (the shell links it with
// ?ver=<APP_VERSION>), so they are network-first too. Lazy chunks are
// content-hashed URLs, so cache-first is safe and keeps them available offline.
const IMPORTANT_PATHS = new Set(
  self.IMPORTANT.map((url) => new URL(url, self.registration.scope).pathname)
);

// The shell cache-busts build-versioned assets with ?ver=<APP_VERSION>, but the
// precache stores the bare URL. Match and store by a query-stripped key so the
// two meet, and so offline fallback still finds the precached copy.
function cacheKeyOf(requestOrUrl) {
  const href =
    typeof requestOrUrl === "string"
      ? requestOrUrl
      : requestOrUrl.href ?? requestOrUrl.url;
  const url = new URL(href);
  url.search = "";
  return url.toString();
}

async function putCacheable(key, response) {
  const contentType = response.headers.get("content-type") || "";
  // .map files (dev-only, served as application/json and fetched by DevTools)
  // don't pass the js/css content-type check; cache them too (only in
  // dev/watch and WebLocal builds) so offline debugging still resolves maps.
  const isMap = CACHE_MAPS && /\.map$/.test(key);
  const isCode =
    /\.(js|css)(?:\?|$)/.test(key) &&
    (contentType.includes("javascript") || contentType.includes("text/css"));
  if (response.ok && (isMap || isCode)) {
    const cache = await caches.open(CACHE);
    await cache.put(key, response.clone());
  }
}

// A 404 on a non-IMPORTANT js/css URL means the page is running a stale
// build and references a chunk that was pruned on the server (e.g. after a
// rebuild during an interrupted update). Ask the page to reload so it picks
// up the current app.js/chunk map instead of choking on every refresh.
function isStaleChunk(response, url) {
  return (
    response.status === 404 &&
    !IMPORTANT_PATHS.has(url.pathname) &&
    /\.(js|css)(?:\?|$)/.test(url.pathname)
  );
}

function notifyStaleAsset(url) {
  self.clients.matchAll({ includeUncontrolled: true }).then((clients) => {
    for (const c of clients) {
      c.postMessage({ type: "SW_STALE_ASSET", url });
    }
  });
}

// A fallback response when neither the network nor the cache can satisfy the
// request. Everything here is guarded so event.respondWith() can never reject:
// a rejected respondWith aborts the caller's fetch (a dynamic import mid-swap)
// with a browser "unexpected error" instead of a graceful failure the page can
// handle. Navigations fall back to the cached shell so deep links still load
// the SPA offline; assets get a 504 that the registrar's swap-failed path (or a
// later activation) recovers from.
async function offlineFallback(request) {
  if (request.mode === "navigate") {
    try {
      const shell = await caches.match(self.registration.scope);
      if (shell) return shell;
    } catch (_) {}
  }
  return new Response("", {
    status: 504,
    statusText: "Offline",
    headers: { "Content-Type": "text/plain" },
  });
}

self.addEventListener("fetch", (event) => {
  if (event.request.method !== "GET") return;

  const url = new URL(event.request.url);
  const key = cacheKeyOf(url);
  const networkFirst = NETWORK_FIRST || IMPORTANT_PATHS.has(url.pathname);

  event.respondWith(
    (async () => {
      try {
        if (networkFirst) {
          try {
            const response = await fetch(event.request);
            await putCacheable(key, response);
            if (isStaleChunk(response, url)) notifyStaleAsset(event.request.url);
            return response;
          } catch {
            const cached = await caches.match(key);
            if (cached) return cached;
            // One retry — a dev-server restart drops the first connection, and
            // the second attempt usually lands. Guarded so a second failure
            // falls through to the graceful fallback instead of rejecting.
            const retried = await fetch(event.request).catch(() => null);
            if (retried) return retried;
          }
        } else {
          const cached = await caches.match(key);
          if (cached) return cached;
          const response = await fetch(event.request);
          await putCacheable(key, response);
          if (isStaleChunk(response, url)) notifyStaleAsset(event.request.url);
          return response;
        }
      } catch (_) {
        // Never let the respondWith promise reject.
      }
      return offlineFallback(event.request);
    })()
  );
});

self.addEventListener("message", (event) => {
  if (event.data?.type === "SKIP_WAITING") {
    self.skipWaiting();
  }
});
