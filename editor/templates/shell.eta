<!doctype html>
<html lang="en" data-build-mode="<%= it.BUILD_MODE %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%~ include('partials/head-meta', it) %>
    <script>
      // Pick mobile/desktop chrome before first paint. GuiDesktop always forces
      // desktop chrome unless the viewport is explicitly small (phones); other
      // web builds are purely viewport-driven.
      (function () {
        var isGuiDesktop = document.documentElement.dataset.buildMode === "gui-desktop";
        var isMobile = window.matchMedia("(max-width: 767px)").matches;
        if (isGuiDesktop && isMobile) isMobile = false; // TODO: gui-desktop narrow window
        document.documentElement.classList.add(isMobile ? "mobile-layout" : "desktop-layout");
      })();
    </script>
    <style><%~ it.criticalCss %></style>
    <link rel="stylesheet" href="assets/katex.css?ver=<%= it.APP_VERSION %>" />
    <link rel="stylesheet" href="assets/prosekit-style.css?ver=<%= it.APP_VERSION %>" />
    <link rel="stylesheet" href="assets/prosekit-typography.css?ver=<%= it.APP_VERSION %>" />
  </head>
  <body>
    <div id="app" data-controller="shell" data-shell-editor-outlet="#editor-area">
      <div class="book-layout">
<% if (!it.dockReplacesChrome) { %>
        <nav class="book-leftpanel">
          <div id="sidebar-nav" data-controller="sidebar" data-shell-target="sidebar" data-action="keydown->sidebar#onKeydown">
            <%~ include('partials/skeleton-sidebar', it) %>
          </div>
        </nav>
<% } %>
        <div class="book-content">
          <div id="app-toolbar" class="app-toolbar toolbar-skeleton" data-controller="topbar">
            <%~ include('partials/skeleton-topbar', it) %>
          </div>
          <div class="book-page">
            <div class="book-page-main">
              <%~ include('partials/editor-area', it) %>
            </div>
          </div>
          <footer class="editor-statusbar" data-controller="statusbar">
            <span data-statusbar-target="path" class="editor-statusbar__path"></span>
            <span data-statusbar-target="dirty" class="pending-badge pending-badge-unsaved" hidden>unsaved</span>
            <span data-statusbar-target="stats" class="editor-statusbar__stats" hidden></span>
          </footer>
        </div>
        <% if (!it.dockReplacesChrome) { %>
        <aside class="book-rightpanel" id="meta-panel-mount" data-controller="meta-panel" data-meta-panel-editor-outlet="#editor-area">
          <%~ include('partials/skeleton-meta', it) %>
        </aside>
        <% } %>
      </div>
<% if (it.mobileDock) { %>
      <div id="dock" data-controller="dock">
        <div id="edit-toolbar" data-controller="edit-toolbar" data-edit-toolbar-editor-outlet="#editor-area"></div>
        <div data-dock-target="nav"></div>
      </div>
<% } %>
    </div>
    <div data-controller="update"></div>
<% if (it.thinShell) { %>
    <div id="updater-loader" data-controller="updater-loader"></div>
<% } %>
    <script type="module" src="assets/app.js?ver=<%= it.APP_VERSION %>"></script>
  </body>
</html>
