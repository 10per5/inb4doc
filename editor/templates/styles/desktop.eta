<% if (it.BUILD_MODE !== "gui-mobile") { %>
/* ── Desktop / Web Overrides ─────────────────────────────────────── */

.sidebar-toggle-btn:hover {
  background: var(--color-btn-hover-bg);
  border: 2px solid var(--color-btn-hover-text);
  color: var(--color-btn-hover-text);
}

.sidebar-toggle-btn.active:hover {
  border-color: var(--color-btn-active-hover-text);
  color: var(--color-btn-active-hover-text);
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.3);
}
<% } %>
